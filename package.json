{
  "name": "pest-launch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude \"**/*.{ts,tsx,js,mjs,cjs,json,css}\"",
    "format:check": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude \"**/*.{ts,tsx,js,mjs,cjs,json,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "check:env": "node scripts/check-env.mjs",
    "check:db": "node scripts/check-db.mjs",
    "import:calls": "tsx scripts/import-calls.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@deepgram/sdk": "^4.11.2",
    "@supabase/supabase-js": "^2.58.0",
    "lucide-react": "^1.59.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
