# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------------------
# Secrets — never commit real env files. Only the empty template is tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Customer data (PestLaunch build test) — recordings, transcripts and any
# exports contain personal information and must never be committed.
# ---------------------------------------------------------------------------
# audio
*.mp3
*.wav
*.m4a
*.mp4
*.aac
*.ogg
*.flac
*.webm
# source material & local working folders (root-anchored so code folders aren't caught)
/drive/
/recordings/
/transcripts/
/exports/
/data/
/scripts/output/
# spreadsheets / docs from the Drive folder
*.xlsx
*.xls
*.csv
*.docx
# local JSON dumps of transcripts or analyses
*.transcript.json
*.analysis.json

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build output & caches
# ---------------------------------------------------------------------------
/.next/
/.next-*/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts
.eslintcache
.vitest/

# ---------------------------------------------------------------------------
# Platform / tooling
# ---------------------------------------------------------------------------
.vercel
supabase/.temp/
supabase/.branches/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
